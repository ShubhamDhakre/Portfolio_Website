{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"API,VITE\" -c \"yellow.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "hash-password": "node server/scripts/hashPassword.js",
    "test": "node server/tests/auth.test.js && node server/tests/admin_auth_hardening.test.js && NODE_ENV=test node server/tests/security.test.js && NODE_ENV=test node server/tests/csrf_state_origin.test.js && node server/tests/kv_cross_instance.test.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
