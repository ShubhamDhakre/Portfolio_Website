# Global Control Center Environment Configuration
# Generate your custom password hash using: npm run hash-password <your_password>
ADMIN_PASSWORD_HASH=<generate_hash_using_npm_run_hash_password>

# Session Secret (cryptographically random string of at least 32 characters)
SESSION_SECRET=<generate_secure_random_string_min_32_chars>

# Port and Environment
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated, in addition to localhost and Vercel system domains)
# ALLOWED_ORIGINS=https://yourcustomdomain.com,https://preview.yourcustomdomain.com

# Optional: Shared Key-Value Storage for cross-instance serverless session revocation and persistent settings
# Supports Vercel KV / Upstash Redis REST API (zero npm dependencies)
# KV_REST_API_URL=https://<your-upstash-redis-url>.upstash.io
# KV_REST_API_TOKEN=<your-upstash-redis-rest-token>
